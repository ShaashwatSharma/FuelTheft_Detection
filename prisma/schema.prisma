generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vehicle {
  id                String   @id @default(uuid())
  registrationNo    String   @unique
  // Optional link to provider's external id (e.g., "ABT-TN38AR1930")
  externalVehicleId String?
  model             String?
  tankSize          Int?
  mileageEst        Float?
  createdAt         DateTime @default(now())

  driver  Driver?
  route   Route?  @relation(fields: [routeId], references: [id])
  routeId String?
  sensor  Sensor?

  histories History[]
  summaries SummaryMetrics[]
  events    Event[]
  alerts    Alert[]
}

model Driver {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  licenseNo String   @unique
  createdAt DateTime @default(now())

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  vehicleId String  @unique
}

model Route {
  id         String   @id @default(uuid())
  name       String   @unique
  startPoint String
  endPoint   String
  createdAt  DateTime @default(now())

  vehicles Vehicle[]
}

model Sensor {
  id          String       @id @default(uuid())
  sensorCode  String       @unique
  status      SensorStatus @default(UNKNOWN) // health: OK/OFFLINE/FAULTY
  isActive    Boolean      @default(true)
  installedAt DateTime     @default(now())
  lastSeen    DateTime?

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  vehicleId String  @unique

  readings SensorReading[]
  Event    Event[]
  Alert    Alert[]
  History  History[]
}

model SensorReading {
  id             String   @id @default(uuid())
  timestamp      DateTime
  fuelLevel      Float?
  // optional to accept nulls from provider
  locationLat    Float?
  locationLong   Float?
  speed          Float?
  ignitionStatus String? // "ON"/"OFF" (normalize on ingest)
  odometerKm     Float? // map provider's odoDistance (km)
  deviceVoltage  Float? // map deviceVolt (V)
  address        String?

  // Whether this reading has been processed by the detection pipeline
  processed      Boolean  @default(false)

  isOverSpeed Boolean?

  raw   Json? // minimal forward-compat
  topic String?

  createdAt DateTime @default(now())

  sensor   Sensor @relation(fields: [sensorId], references: [id])
  sensorId String

  @@unique([sensorId, timestamp])
  @@index([sensorId, processed, timestamp])
  @@index([timestamp])
}

model Event {
  id           String    @id @default(uuid())
  timestamp    DateTime
  type         EventType // THEFT, REFUEL, DROP
  deltaLitres  Float? // + for refuel, - for theft
  locationLat  Float?
  locationLong Float?
  description  String?

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  vehicleId String

  sensor   Sensor @relation(fields: [sensorId], references: [id])
  sensorId String

  @@index([vehicleId, timestamp])
}

model Alert {
  id           String    @id @default(uuid())
  timestamp    DateTime  @default(now())
  type         AlertType // e.g., SENSOR_HEALTH, LOW_FUEL
  description  String?
  locationLat  Float?
  locationLong Float?

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  vehicleId String

  sensor   Sensor? @relation(fields: [sensorId], references: [id])
  sensorId String?
}

model History {
  id             String    @id @default(uuid())
  timestamp      DateTime  @default(now())
  type           AlertType // store model classification for each reading
  description    String
  fuelLevel      Float
  fuelDropLitres Float?

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  vehicleId String

  sensor   Sensor @relation(fields: [sensorId], references: [id])
  sensorId String

  locationLat  Float?
  locationLong Float?
}

model SummaryMetrics {
  id                 String   @id @default(uuid())
  vehicleId          String
  fromDate           DateTime
  toDate             DateTime
  sFuelLevel         Float
  eFuelLevel         Float
  totalFuelConsumed  Float
  totalFuelFills     Float
  totalFuelDrops     Float
  kmpl               Float
  totalDistanceKm    Float
  totalRunningHours  Float
  totalIdleHours     Float
  totalStoppageHours Float
  dropAlert          Boolean  @default(false)
  fillAlert          Boolean  @default(false)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([fromDate, toDate])
}

enum EventType {
  THEFT
  REFUEL
  DROP
}

enum AlertType {
  THEFT
  REFUEL
  LOW_FUEL
  SENSOR_HEALTH
  NORMAL
  UNKNOWN
}

enum SensorStatus {
  OK
  OFFLINE
  FAULTY
  UNKNOWN
}
